rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isAuth() && userDoc().role == 'admin'; }
    function isMod() { return isAuth() && (userDoc().role == 'moderator' || userDoc().role == 'admin'); }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Okuma: e-posta gibi PII sızmasın diye yalnızca sahip + moderatör/admin
      // (yorum yazarı bilgisi review belgesinde denormalize tutulur)
      allow read: if isOwner(uid) || isMod();
      // Kayıt: kullanıcı kendi belgesini yalnızca 'user' rolüyle oluşturabilir
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      // Güncelleme: admin her şeyi; sahip ise role/active/deleted alanlarını DEĞİŞTİREMEZ
      // (yetki yükseltme ve kendini-aktif-etmeyi engeller)
      allow update: if isAdmin()
                     || (isOwner(uid)
                         && request.resource.data.role == resource.data.role
                         && request.resource.data.active == resource.data.active
                         && request.resource.data.get('deleted', false) == resource.data.get('deleted', false));
      allow delete: if isOwner(uid) || isAdmin();

      // Favoriler alt-koleksiyonu
      match /favorites/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Usernames (benzersizlik için) ─────────────────────────────────────
    match /usernames/{username} {
      allow get: if true;        // giriş ve kullanıcı adı benzersizlik kontrolü
      allow list: if isMod();    // toplu e-posta hasadı (enumeration) engellendi
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── Brands ───────────────────────────────────────────────────────────
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Perfumes (orijinal) ───────────────────────────────────────────────
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Muadils ───────────────────────────────────────────────────────────
    match /muadils/{muadilId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      // Oluşturma: yalnızca kendi adına, 'pending' durumla, gerçek rolüyle ve
      // doğrulanmış e-posta ile (moderasyon atlatma + rol taklidini engeller)
      allow create: if isAdmin() || (isAuth()
                     && request.resource.data.userId == request.auth.uid
                     && request.resource.data.status == 'pending'
                     && request.resource.data.userRole == userDoc().role
                     && request.auth.token.email_verified == true);
      // Güncelleme: mod her şeyi; sahip yalnızca bekleyen yorumunu (durumu 'pending' kalmak
      // şartıyla) düzenleyebilir; ya da hesap silinince anonimleştirme
      allow update: if isMod()
                     || (isOwner(resource.data.userId)
                         && resource.data.status == 'pending'
                         && request.resource.data.status == 'pending')
                     || (isAuth() && resource.data.userId == request.auth.uid && request.resource.data.userId == 'deleted');
      allow delete: if isMod();
    }

    // ── Slider Images ─────────────────────────────────────────────────────
    match /sliderImages/{imgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site Settings (favicon vb.) ───────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
