rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return isAuth() && userDoc().role == 'admin'; }
    function isMod() { return isAuth() && (userDoc().role == 'moderator' || userDoc().role == 'admin'); }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Okuma: e-posta gibi PII sızmasın diye yalnızca sahip + moderatör/admin
      // (yorum yazarı bilgisi review belgesinde denormalize tutulur)
      allow read: if isOwner(uid) || isMod();
      // Kayıt: kullanıcı kendi belgesini yalnızca 'user' rolüyle oluşturabilir
      allow create: if isOwner(uid) && request.resource.data.role == 'user';
      // Güncelleme: admin her şeyi; sahip ise role/active/deleted alanlarını DEĞİŞTİREMEZ
      // (yetki yükseltme ve kendini-aktif-etmeyi engeller)
      // (createdAt sabittir: 24 saat yeni-hesap kuralının atlatılmasını engeller)
      allow update: if isAdmin()
                     || (isOwner(uid)
                         && request.resource.data.role == resource.data.role
                         && request.resource.data.active == resource.data.active
                         && request.resource.data.get('deleted', false) == resource.data.get('deleted', false)
                         && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isOwner(uid) || isAdmin();

      // Favoriler alt-koleksiyonu
      match /favorites/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Parfüm listeleri alt-koleksiyonu (herkese okunabilir, sadece sahip yazabilir)
      match /perfumeLists/{listId} {
        allow read: if true;
        allow write: if isOwner(uid);
      }
    }

    // ── Public Profiles ───────────────────────────────────────────────────
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid) || isAdmin();
    }

    // ── Usernames (benzersizlik için) ─────────────────────────────────────
    match /usernames/{username} {
      // Admin kullanıcı adı belgesi e-posta içerir; yalnızca admin okuyabilir.
      // Diğer belgeler: giriş ve kullanıcı adı benzersizlik kontrolü için herkese açık.
      allow get: if username != 'admin' || isAdmin();
      allow list: if isMod();    // toplu e-posta hasadı (enumeration) engellendi
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
    }

    // ── Brands ───────────────────────────────────────────────────────────
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Perfumes (orijinal) ───────────────────────────────────────────────
    match /perfumes/{perfumeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Muadils ───────────────────────────────────────────────────────────
    match /muadils/{muadilId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────────────────
    // Metin en az 40 karakter olmalı (spam/düşük efor sunucu kapısı).
    function validReviewLen(t) { return t is string && t.size() >= 40 && t.size() <= 4000; }
    // Sahip yalnızca gönderimden sonraki 5 dakika içinde düzenleyebilir.
    function withinEditWindow() {
      return resource.data.createdAt is timestamp
             && request.time < resource.data.createdAt + duration.value(5, 'm');
    }
    match /reviews/{reviewId} {
      allow read: if true;
      // Oluşturma client'tan KAPALIDIR. Normal kullanıcı yorumları yalnızca
      // 'submitReview' Cloud Function (Admin SDK) üzerinden oluşturulur; böylece
      // 24 saat yeni-hesap kuralı, IP hız limiti ve metin kalite kontrolü atlatılamaz.
      // Yalnızca admin'e doğrudan acil oluşturma izni bırakıldı.
      allow create: if isAdmin();
      // Güncelleme: mod her şeyi; sahip pending yorumunu düzenleyebilir ya da
      // approved yorumunu pending_update'e geçirebilir; hesap silinince anonimleştirme.
      // Sahip düzenlemelerinde metin minimum uzunluk + 5dk düzenleme penceresi geçerli.
      allow update: if isMod()
                     || (isOwner(resource.data.userId)
                         && resource.data.status == 'pending'
                         && request.resource.data.status == 'pending'
                         && validReviewLen(request.resource.data.text)
                         && withinEditWindow())
                     || (isOwner(resource.data.userId)
                         && resource.data.status == 'approved'
                         && request.resource.data.status == 'pending_update'
                         && validReviewLen(request.resource.data.pendingUpdate.text)
                         && withinEditWindow())
                     || (isOwner(resource.data.userId)
                         && resource.data.status == 'pending_update'
                         && request.resource.data.status == 'pending_update'
                         && validReviewLen(request.resource.data.pendingUpdate.text)
                         && withinEditWindow())
                     || (isAuth() && resource.data.userId == request.auth.uid && request.resource.data.userId == 'deleted');
      allow delete: if isMod() || isOwner(resource.data.userId);
    }

    // ── Rate Limits (sadece Cloud Functions / Admin SDK yazar) ──────────────
    // Hash'li IP ve kullanıcı sayaçları; client erişemez, admin inceleyebilir.
    match /rateLimits/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Abuse Signals (spam/suistimal izleri) ───────────────────────────────
    // Yalnızca Cloud Functions yazar; mod/admin inceler. Raw IP saklanmaz (hash).
    match /abuseSignals/{docId} {
      allow read: if isMod();
      allow write: if false;
    }

    // ── Activity Logs ─────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      // Yalnızca kendi UID'ini yazabilir; URL alanları / ile başlayan iç path olmalı
      allow create: if isAuth()
                     && request.resource.data.userId == request.auth.uid
                     && (!request.resource.data.keys().hasAny(['perfumeUrl'])
                         || request.resource.data.perfumeUrl == null
                         || request.resource.data.perfumeUrl.matches('^/[a-zA-Z0-9/?=&@_.%-]*$'))
                     && (!request.resource.data.keys().hasAny(['listUrl'])
                         || request.resource.data.listUrl == null
                         || request.resource.data.listUrl.matches('^/@[a-zA-Z0-9_-]+[/?].*$'));
    }

    // ── Presence (aktif kullanıcı takibi) ────────────────────────────────
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if isOwner(uid);
    }

    // ── Slider Images ─────────────────────────────────────────────────────
    match /sliderImages/{imgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Site Settings (favicon vb.) ───────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // Okuma: kullanıcı kendi bildirimlerini; mod/admin staff bildirimlerini okur
      allow read: if isAuth() && (
        (resource.data.get('forStaff', false) == true && isMod()) ||
        resource.data.userId == request.auth.uid
      );
      // Oluşturma: staff bildirimleri yalnızca doğrulanmış e-posta ve kendi UID'i ile;
      // kullanıcıya özel bildirimleri yalnızca mod/admin oluşturabilir
      allow create: if isAuth() && (
        (request.resource.data.get('forStaff', false) == true
          && request.auth.token.email_verified == true
          && request.resource.data.userId == request.auth.uid)
        || isMod()
      );
      // Güncelleme (okundu işareti / temizle): sahip veya mod/admin
      allow update: if isAuth() && (
        (resource.data.get('forStaff', false) == true && isMod()) ||
        resource.data.userId == request.auth.uid
      );
      // Silme: yalnızca kişisel bildirim sahibi
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }
  }
}
