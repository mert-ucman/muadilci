rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Admin kontrolü: Firebase Auth custom claim ile yapılır (firestore.get yerine)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Görsel doğrulama: yalnızca resim ve maks. 5MB
    function validImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Parfüm / muadil görselleri — herkese açık okuma, admin yazma
    match /perfumes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Marka logoları
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Favicon
    match /favicon/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Ana sayfa slider görselleri
    match /slider/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Kullanıcı profil fotoğrafları
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && validImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Yorumlara eklenen kullanıcı parfüm fotoğrafları — sahip yükler, admin de silebilir
    match /reviews/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && validImage();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
